# Private runtime configuration. Store outside Git, chmod 0600.
# Empty values deliberately prevent startup; never paste real secrets in chat.
# Compose sets production/beta/aws, us-east-2, public origin and container paths.
MAPTALK_APPLE_CLIENT_ID=
MAPTALK_APPLE_TEAM_ID=
MAPTALK_APPLE_KEY_ID=
MAPTALK_APPLE_TOKEN_ENCRYPTION_KEY=
MAPTALK_BACKUP_ENCRYPTION_KEY=
MAPTALK_BACKUP_S3_BUCKET=
MAPTALK_BACKUP_S3_PREFIX=maptalk/backups/
# Do not add AWS access keys or copy a developer's ~/.aws directory.
# The EC2 instance role supplies short-lived credentials.
